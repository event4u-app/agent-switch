{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray",
  "description": "Tray popover window: reads the view model through the agent-switch CLI (same scoped shell entries as main), forwards overlays to the main window via events. No autostart writes, no notifications.",
  "windows": ["tray"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "autostart:allow-is-enabled",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "agent-switch",
          "cmd": "agent-switch",
          "args": true
        },
        {
          "name": "agent-config-version",
          "cmd": "agent-config",
          "args": ["--version"]
        }
      ]
    }
  ]
}
