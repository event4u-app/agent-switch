{
  "name": "@event4u/agent-switch",
  "version": "2.14.1",
  "description": "Claude Code, Codex and Antigravity accounts signed in side by side; each session starts on the one with the most left.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/event4u-app/agent-switch.git"
  },
  "type": "module",
  "bin": {
    "agent-switch": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "prepack": "node scripts/prepack-check.mjs",
    "test": "tsc -p tsconfig.test.json && cd dist-test && node --test",
    "coverage": "tsc -p tsconfig.test.json && cd dist-test && node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=69 --test-coverage-branches=72 --test-coverage-functions=68"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "antigravity",
    "multi-account",
    "account-switcher",
    "ai-coding",
    "rate-limit",
    "usage",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://event4u-app.github.io/agent-switch/",
  "bugs": {
    "url": "https://github.com/event4u-app/agent-switch/issues"
  }
}
