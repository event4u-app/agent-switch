+/** Menus and popovers (drawn open for the design boards). */
+import type { ReactNode } from "react";
+import { Check, ChevronDown, ChevronRight, Code, Copy, ExternalLink, Folder, GitPullRequest, Laptop, Settings2, SquareTerminal } from "lucide-react";
+import { cn } from "../lib/utils.js";
+import { Kbd } from "../ui/Typography.js";
+
+export interface MenuItem {
+  label: ReactNode;
+  icon?: ReactNode;
+  hint?: ReactNode;
+  kbd?: string;
+  sub?: boolean;
+  active?: boolean;
+  checked?: boolean;
+  disabled?: boolean;
+  danger?: boolean;
+  divider?: boolean;
+  /** A wrapped explanatory line instead of an item. */
+  note?: string;
+}
+
+export function Menu({ items, width = 260, className }: { items: MenuItem[]; width?: number; className?: string }) {
+  return (
+    <div role="menu" className={cn("rounded-xl border border-ac-line2 bg-ac-panel p-1", className)} style={{ width, boxShadow: "var(--ac-shadow)" }}>
+      {items.map((it, i) =>
+        it.note ? (
+          <p key={i} className="px-2 py-1.5 text-[11.5px] leading-snug text-ac-muted">
+            {it.note}
+          </p>
+        ) : it.divider ? (
+          <div key={i} className="my-1 h-px bg-ac-line" />
+        ) : (
+          <div
+            key={i}
+            role="menuitem"
+            aria-disabled={it.disabled || undefined}
+            className={cn(
+              "flex h-8 items-center gap-2.5 rounded-md px-2 text-[13px]",
+              it.active ? "bg-ac-raise text-ac-text" : "text-ac-soft",
+              it.disabled && "text-ac-faint",
+              it.danger && "text-ac-alert-text",
+            )}
+          >
+            <span className="inline-flex size-4 shrink-0 items-center justify-center text-ac-muted [&_svg]:size-4">{it.checked ? <Check className="text-ac-brand-text" /> : it.icon}</span>
+            <span className="min-w-0 flex-1 truncate">{it.label}</span>
+            {it.hint && <span className="shrink-0 truncate text-[11px] text-ac-muted">{it.hint}</span>}
+            {it.kbd && <Kbd>{it.kbd}</Kbd>}
+            {it.sub && <ChevronRight className="size-3.5 shrink-0 text-ac-faint" />}
+          </div>
+        ),
+      )}
+    </div>
+  );
+}
+
+/** Split button: main part opens the default target, caret opens the menu. */
+export function OpenInButton({ open }: { open?: boolean }) {
+  return (
+    <span className="inline-flex h-7 shrink-0 items-stretch overflow-hidden rounded-md border border-ac-line2 bg-ac-raise text-xs text-ac-soft">
+      <button type="button" title="Open in PhpStorm (default) · ⌘O" className="inline-flex items-center gap-1.5 px-2 hover:text-ac-text">
+        <AppMono m="PS" />
+        Open
+      </button>
+      <button type="button" aria-label="Open in…" className={cn("inline-flex items-center border-l border-ac-line2 px-1.5 hover:text-ac-text", open && "bg-ac-bg text-ac-text")}>
+        <ChevronDown className="size-3.5" />
+      </button>
+    </span>
+  );
+}
+
+/** Monogram for an app without a usable glyph — one style for all. */
+export function AppMono({ m }: { m: string }) {
+  return <span className="inline-flex size-4 items-center justify-center rounded bg-ac-raise font-ac-mono text-[9px] font-semibold text-ac-soft">{m}</span>;
+}
+
+export function OpenInMenu({ tool = "claude", reverse }: { tool?: "claude" | "codex"; reverse?: boolean }) {
+  const app = tool === "claude" ? "Claude Desktop" : "Codex Desktop";
+  return (
+    <div className={cn("flex items-start gap-1", reverse && "flex-row-reverse")}>
+      <Menu
+        width={268}
+        items={[
+          { label: "PhpStorm", icon: <AppMono m="PS" />, hint: "default", kbd: "1" },
+          { label: app, icon: <AppMono m={tool === "claude" ? "C" : "Cx"} />, hint: "last used", kbd: "2" },
+          { divider: true, label: "" },
+          { label: "Editor", icon: <Code />, sub: true },
+          { label: "Agent app", icon: <Laptop />, sub: true, active: true },
+          { label: "Terminal", icon: <SquareTerminal />, sub: true },
+          { label: "Files", icon: <Folder />, sub: true },
+          { label: "Web", icon: <GitPullRequest />, hint: "PR #142", sub: true },
+          { divider: true, label: "" },
+          { label: "Configure targets…", icon: <Settings2 /> },
+        ]}
+      />
+      <Menu
+        width={280}
+        items={[
+          { label: app, icon: <AppMono m={tool === "claude" ? "C" : "Cx"} />, hint: "opens this project", active: true },
+          { label: "", note: "Only the app for this session's tool is offered. Continuing the same conversation there appears only where that app supports it." },
+        ]}
+      />
+    </div>
+  );
+}
+
+export function EditorSubmenu() {
+  return (
+    <Menu
+      width={260}
+      items={[
+        { label: "PhpStorm", icon: <AppMono m="PS" />, hint: "default", checked: true },
+        { label: "VS Code", icon: <Code /> },
+        { label: "Cursor", icon: <Code />, hint: "not installed", disabled: true },
+        { divider: true, label: "" },
+        { label: "Copy path", icon: <Copy /> },
+        { label: "Open PR on GitHub", icon: <ExternalLink /> },
+      ]}
+    />
+  );
+}
