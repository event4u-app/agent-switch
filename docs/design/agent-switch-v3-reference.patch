+}
+
+/* ------------------------------------------------------------- shell */
+
+export function Shell({
+  left = "sessions",
+  right = null,
+  activeId = "s-store",
+  centre,
+  rightBody,
+  overlay,
+  leftBody,
+  inboxOpen,
+  health,
+}: {
+  left?: string | null;
+  right?: string | null;
+  activeId?: string;
+  centre: ReactNode;
+  rightBody?: ReactNode;
+  overlay?: ReactNode;
+  leftBody?: ReactNode;
+  inboxOpen?: boolean;
+  health?: "ready" | "down";
+}) {
+  return (
+    <div className="relative flex h-full min-h-0 flex-col bg-ac-bg">
+      <TitleBar inboxOpen={inboxOpen} health={health} showInbox={left !== "sessions"} />
+      <div className="flex min-h-0 flex-1">
+        <Stripe side="left" items={LEFT.map((l) => (l.id === "sessions" ? { ...l, dot: left !== "sessions" } : l))} active={left} />
+        {left === "sessions" && (leftBody ?? <SessionsWindow activeId={activeId} />)}
+        {centre}
+        {right && rightBody}
+        <Stripe side="right" items={RIGHT.map((r) => (r.id === "summary" && NEXT[activeId]?.blocker ? { ...r, dot: true } : r))} active={right} />
+      </div>
+      {overlay}
+    </div>
+  );
+}
+
+export { GitPullRequest };
