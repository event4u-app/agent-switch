+/**
+ * v3 building blocks. Each one is used unchanged in the sidebar, the session
+ * card, the inspector, the tray and the library — so the same fact always looks
+ * the same (owner rule "consistent").
+ */
+import type { ReactNode } from "react";
+import {
+  ArrowDown,
+  ArrowUp,
+  CircleCheck,
+  CircleDashed,
+  CircleHelp,
+  CircleX,
+  Code,
+  Folder,
+  FolderGit2,
+  GitBranch,
+  GitMerge,
+  GitPullRequest,
+  GitPullRequestClosed,
+  GitPullRequestDraft,
+  LoaderCircle,
+  SquareTerminal,
+  Unplug,
+} from "lucide-react";
+import { cn } from "../lib/utils.js";
+import { AccountDot } from "../ui/AccountDot.js";
+import { SessionStateIcon } from "../ui/SessionStateIcon.js";
+import type { SessionState } from "../vm/types.js";
+import { accountOf, type Child, type Kind, type PR, type Source, type V3Session } from "./data.js";
+
+const SOURCE_TEXT: Record<Source, string> = {
+  hook: "from the session's hooks",
+  lineage: "from the lineage contract (AGENT_SWITCH_PARENT_SESSION)",
+  git: "observed with git",
+  gh: "from GitHub (gh)",
+  heuristic: "guessed from the working folder — not proven",
+  counted: "counted from the session folder, content not read",
+  host: "from the AS host",
+};
+
+/** Branch · worktree · dirty · ahead/behind — one chip row, mono. */
+export function GitFacts({ s, size = "md", withSource }: { s: V3Session; size?: "sm" | "md"; withSource?: boolean }) {
+  if (!s.branch) return <span className="text-xs text-ac-faint">no git repo</span>;
+  const text = size === "sm" ? "text-[11px]" : "text-xs";
+  return (
+    <span className={cn("inline-flex min-w-0 items-center gap-2 font-ac-mono text-ac-soft", text)}>
+      <span className="inline-flex min-w-0 items-center gap-1" title={`branch · ${SOURCE_TEXT[s.branchSource]}`}>
+        <GitBranch className="size-3.5 shrink-0 text-ac-muted" />
+        <span className="truncate">{s.branch}</span>
+      </span>
+      {s.worktree && (
+        <span className="inline-flex shrink-0 items-center gap-1 text-ac-violet-text" title={`worktree ${s.worktree}`}>
+          <FolderGit2 className="size-3.5" />
+          {size === "md" && s.worktree}
+        </span>
+      )}
+      {s.dirty > 0 && (
+        <span className="shrink-0 text-ac-warn-text" title={`${s.dirty} uncommitted changes`}>
+          ●{s.dirty}
+        </span>
+      )}
+      {(s.ahead > 0 || s.behind > 0) && (
+        <span className="inline-flex shrink-0 items-center text-ac-muted" title={`${s.ahead} ahead, ${s.behind} behind upstream`}>
+          <ArrowUp className="size-3" />
+          {s.ahead}
+          <ArrowDown className="ml-0.5 size-3" />
+          {s.behind}
+        </span>
+      )}
+      
+    </span>
+  );
+}
+
+const LIFECYCLE: Record<PR["lifecycle"], { icon: typeof GitPullRequest; cls: string; label: string }> = {
+  open: { icon: GitPullRequest, cls: "text-ac-ok-text", label: "open" },
+  draft: { icon: GitPullRequestDraft, cls: "text-ac-muted", label: "draft" },
+  merged: { icon: GitMerge, cls: "text-ac-violet-text", label: "merged" },
+  closed: { icon: GitPullRequestClosed, cls: "text-ac-alert-text", label: "closed" },
+};
+
+export function CiIcon({ state, className }: { state: PR["ci"] | "passing" | "failing" | "running"; className?: string }) {
+  const c = cn("size-3.5 shrink-0", className);
+  if (state === "passing") return <CircleCheck className={cn(c, "text-ac-ok")} aria-label="CI passing" />;
+  if (state === "failing") return <CircleX className={cn(c, "text-ac-alert")} aria-label="CI failing" />;
+  if (state === "running") return <LoaderCircle className={cn(c, "text-ac-warn")} aria-label="CI running" />;
+  return <CircleDashed className={cn(c, "text-ac-faint")} aria-label="CI unknown" />;
+}
+
+const MERGE: Record<PR["mergeable"], { label: string; tone: string }> = {
+  clean: { label: "mergeable", tone: "text-ac-ok-text" },
+  conflict: { label: "conflict", tone: "text-ac-alert-text" },
+  blocked: { label: "blocked", tone: "text-ac-warn-text" },
+  unknown: { label: "UNKNOWN", tone: "text-ac-faint" },
+};
+const REVIEW: Record<PR["review"], { label: string; tone: string }> = {
+  approved: { label: "approved", tone: "text-ac-ok-text" },
+  changes: { label: "changes requested", tone: "text-ac-alert-text" },
+  required: { label: "review required", tone: "text-ac-warn-text" },
+  none: { label: "no review", tone: "text-ac-muted" },
+  unknown: { label: "UNKNOWN", tone: "text-ac-faint" },
+};
+
+/** PR chip: lifecycle, CI, mergeable, review stay separate axes. */
+export function PRChip({ pr, size = "md" }: { pr: PR | null; size?: "sm" | "md" }) {
+  if (!pr) return <span className="text-xs text-ac-faint">no PR</span>;
+  const L = LIFECYCLE[pr.lifecycle];
+  const live = pr.lifecycle === "open" || pr.lifecycle === "draft";
+  return (
+    <span className={cn("inline-flex min-w-0 items-center gap-2", size === "sm" ? "text-[11px]" : "text-xs")}>
+      <span className={cn("inline-flex shrink-0 items-center gap-1 font-medium", L.cls)} title={`PR #${pr.number} ${L.label} · ${SOURCE_TEXT.gh}`}>
+        <L.icon className="size-3.5" />
+        <span className="font-ac-mono">#{pr.number}</span>
+        {size === "md" && <span>{L.label}</span>}
+      </span>
+      <span title={`CI ${pr.ci}`}>
+        <CiIcon state={pr.ci} />
+      </span>
+      {live && <span className={cn("shrink-0 whitespace-nowrap", MERGE[pr.mergeable].tone)}>{MERGE[pr.mergeable].label}</span>}
+      {live && size === "md" && <span className={cn("shrink-0 whitespace-nowrap", REVIEW[pr.review].tone)}>{REVIEW[pr.review].label}</span>}
+    </span>
+  );
+}
+
+export function StateDot({ state }: { state: SessionState }) {
+  return <SessionStateIcon state={state} />;
+}
+
+/** `compact` (inside a card whose header already names the kind): no kind badge. */
