+/** Tools page: the 2.11 Tools screen in the v3 frame. */
+export function ToolsPage() {
+  const tools = [
+    { name: "Claude Code", v: "2.4.1", latest: "2.4.1", path: "/usr/local/bin/claude" },
+    { name: "Codex CLI", v: "0.148.0", latest: "0.150.0", path: "/opt/homebrew/bin/codex" },
+    { name: "agent-config", v: "16.5.0", latest: "16.5.0", path: "npm · global" },
+    { name: "tmux", v: "3.5a", latest: "3.5a", path: "/opt/homebrew/bin/tmux" },
+    { name: "gh", v: "2.62.0", latest: "2.62.0", path: "/opt/homebrew/bin/gh · signed in" },
+  ];
+  return (
+    <PageBody title="Tools" sub="What Agent Switch runs, which version, and what's new. Updates never touch running sessions." actions={<Act>Check now</Act>}>
+      <div className="overflow-hidden rounded-[10px] border border-ac-line bg-ac-panel">
+        {tools.map((t) => (
+          <div key={t.name} className="grid grid-cols-[minmax(0,1fr)_120px_150px] items-center gap-3 border-b border-ac-line px-4 py-3 last:border-b-0">
+            <span className="min-w-0">
+              <span className="block text-[13px] text-ac-text">{t.name}</span>
+              <span className="block truncate font-ac-mono text-[11px] text-ac-muted">{t.path}</span>
+            </span>
+            <span className="font-ac-mono text-xs text-ac-soft">{t.v}</span>
+            <span className="flex justify-end">
+              {t.v === t.latest ? (
+                <Chip>up to date</Chip>
+              ) : (
+                <Act kind="accent">
+                  <Download /> Update to {t.latest}
+                </Act>
+              )}
+            </span>
+          </div>
+        ))}
+      </div>
+    </PageBody>
+  );
+}
+
+export { Layers, Plus, SquareTerminal, Terminal, Wrench };
+
+/** Hover card on a session row: the details that left the row. One at a time, ~400 ms delay. */
+export function SessionPeek({ id = "s-store", top = 200 }: { id?: string; top?: number }) {
+  const s = SESSIONS.find((x) => x.id === id)!;
+  const a = accountOf(s.account);
+  return (
+    <div className="absolute left-[352px] z-10 w-[300px] rounded-xl border border-ac-line2 bg-ac-panel p-3" style={{ top, boxShadow: "var(--ac-shadow)" }}>
+      <div className="flex items-center gap-2">
+        <StateDot state={s.state} />
+        <span className="min-w-0 flex-1 truncate text-[13px] font-medium text-ac-text">{s.title}</span>
+        <span className="shrink-0 text-[11px] text-ac-muted">{s.lastActive}</span>
+      </div>
+      <div className="mt-1.5 space-y-1 text-xs text-ac-muted">
+        <div className="flex items-center gap-2 text-ac-soft">
+          <AccountMark color={a.color} /> {a.tool === "claude" ? "Claude" : "Codex"} · {a.name} · {s.model} · {s.effort}
+        </div>
+        <div className="flex min-w-0 items-center gap-1.5">
+          <GitBranch className="size-3.5 shrink-0" />
+          <span className="truncate">
+            {s.branch}
+            {s.pr ? ` · #${s.pr.number} ${s.pr.lifecycle}` : ""}
+            {s.children.length ? ` · ${s.children.length} children` : ""}
+          </span>
+        </div>
+        <div className="truncate font-ac-mono text-[11px]">{s.preview}</div>
+      </div>
+    </div>
+  );
+}
