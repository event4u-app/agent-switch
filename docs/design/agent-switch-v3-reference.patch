+            type="button"
+            role="radio"
+            aria-checked={view === id}
+            aria-disabled={(own && id === "chat") || undefined}
+            title={own && id === "chat" ? "Chat needs a session hosted in Agent Switch" : `${label} · switches between turns`}
+            className={cn(
+              "inline-flex h-full items-center gap-1.5 rounded-md px-2 text-xs",
+              view === id ? "bg-ac-raise font-medium text-ac-text" : "text-ac-muted",
+              own && id === "chat" && "opacity-60",
