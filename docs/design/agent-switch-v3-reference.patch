+    limits: [
+      { label: "5h", used: 12, resetsIn: "4h 01m", pace: 20 },
+      { label: "week", used: 23, resetsIn: "2d 5h", pace: 70 },
+    ],
+    checked: "2m ago", live: 2,
+  },
+  {
+    id: "claude:side", name: "side", tool: "claude", color: "purple", email: "side@example.com", label: "Other", state: "near-limit", protect: 98,
+    limits: [
