+        {a.name}
+        <span className="ml-1 inline-flex items-center gap-1">
+          <span className="relative h-1.5 w-8 rounded-full bg-ac-raise">
+            <span className={cn("absolute inset-y-0 left-0 rounded-full", t === "alert" ? "bg-ac-alert" : t === "warn" ? "bg-ac-warn" : "bg-ac-ok")} style={{ width: `${fiveH?.used ?? 0}%` }} />
+          </span>
+          <span className={cn("font-ac-mono text-[10.5px]", t === "ok" ? "text-ac-muted" : "text-ac-warn-text")}>{fiveH?.used}%</span>
+        </span>
+      </Chip>
+      <Chip title={own ? "Locked: change it in your terminal (/model)" : "Model for the next turn"} locked={own} open={chipOpen === "model"}>
+        {s.model}
+      </Chip>
