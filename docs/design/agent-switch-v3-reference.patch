+  Plus,
+  Search,
+  Settings,
+  SquareTerminal,
+  TriangleAlert,
+  Wrench,
+  X,
+} from "lucide-react";
+import { cn } from "../lib/utils.js";
+import { AppLogo } from "../ui/AppLogo.js";
+import { Button, IconButton } from "../ui/Button.js";
+import { Kbd } from "../ui/Typography.js";
+import { StateDot } from "./bits.js";
+import { ACCOUNTS, NEXT, SESSIONS, TERMINAL, TERMINAL_CHECKOUT, TERMINAL_CODEX, accountOf, sessionById, type Child, type V3Session } from "./data.js";
+import { Act, AccountMark, BatchBar, Later, Marker } from "./kit.js";
+import { LimitRow, tightest, tone } from "./limits.js";
+import { OpenInButton } from "./menus.js";
+
+/* ------------------------------------------------------------- attention */
+
+export interface NeedItem {
+  id: string;
+  icon: ReactNode;
+  /** Who — short session or account name. */
+  who: string;
+  /** What, as a short verb phrase. */
+  what: string;
+  /** Shown only on the top item, on hover and in the inbox. */
+  detail: string;
+  verb: string;
+  keys?: string;
+  tone: "warn" | "info";
+  session?: string;
+}
+
+/** One queue, ordered by urgency: approvals and questions first. */
+export const NEEDS: NeedItem[] = [
+  { id: "n1", icon: <Hand />, who: "Theme system", what: "wants to run", detail: "npx vitest run src/v3", verb: "Allow", keys: "↵ once · ⇧↵ always · ⌫ deny · L later", tone: "warn", session: "s-themes" },
+  { id: "n5", icon: <MessageCircleQuestion />, who: "Checkout flow", what: "asks you", detail: "“Rebase first?”", verb: "Reply", keys: "↵ reply · Y yes · L later", tone: "warn", session: "s-checkout" },
+  { id: "n2", icon: <TriangleAlert />, who: "side", what: "94% of 5h", detail: "resets in 1h 18m · 1 session on it", verb: "Decide", tone: "warn" },
+  { id: "n6", icon: <CircleX />, who: "#311", what: "CI failing", detail: "e2e (chromium) · Checkout flow", verb: "Fix", tone: "warn", session: "s-checkout" },
+  { id: "n3", icon: <LogIn />, who: "Codex · personal", what: "sign in", detail: "stored login expired", verb: "Sign in", tone: "info" },
+  { id: "n4", icon: <Download />, who: "Codex CLI", what: "0.150.0", detail: "running sessions untouched", verb: "Update", tone: "info" },
+];
+
+/** One line per item; the top (or focused) item shows its detail and keys. */
+export function NeedRow({ n, top, focused, wide }: { n: NeedItem; top?: boolean; focused?: boolean; wide?: boolean }) {
+  const open = top || focused || wide;
+  return (
+    <div className={cn("relative rounded-md px-2", open ? "py-1.5" : "py-1", focused ? "bg-ac-raise" : "hover:bg-ac-raise")} title={open ? undefined : n.detail}>
+      {focused && <Marker tone="warn" />}
+      <div className="flex h-6 items-center gap-2">
+        <span className={cn("shrink-0 [&_svg]:size-3.5", n.tone === "warn" ? "text-ac-warn-text" : "text-ac-muted")}>{n.icon}</span>
+        <span className="min-w-0 flex-1 truncate text-[12.5px]">
+          <span className="text-ac-text">{n.who}</span> <span className="text-ac-muted">{n.what}</span>
+        </span>
+        <span className={cn("rounded-md", focused && "ring-2 ring-ac-brand ring-offset-2 ring-offset-[var(--ac-raise)]")}>
+          {open ? <Act kind="accent">{n.verb}</Act> : <Act kind="ghost">{n.verb}</Act>}
+        </span>
+      </div>
+      {open && <div className="truncate pl-[22px] font-ac-mono text-[11px] text-ac-muted">{n.detail}</div>}
+      {focused && n.keys && <div className="mt-0.5 pl-[22px] text-[10.5px] text-ac-muted">{n.keys}</div>}
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------- title bar */
+
+export function TitleBar({ inboxOpen, health = "ready", showInbox }: { inboxOpen?: boolean; health?: "ready" | "down"; showInbox?: boolean }) {
+  return (
+    <header className="relative flex h-11 shrink-0 items-center gap-2 border-b border-ac-line bg-ac-rail pl-[84px] pr-3">
+      <AppLogo className="size-6" />
+      <span className="mr-2 text-[13px] font-semibold text-ac-text">Agent Switch</span>
+      <div className="flex flex-1 justify-center">
+        <button type="button" className="inline-flex h-7 w-[420px] items-center gap-2 rounded-md border border-ac-line2 bg-ac-bg px-2.5 text-xs text-ac-muted">
+          <Search className="size-3.5" />
+          <span className="flex-1 truncate text-left">Go to session, account, branch, PR, or run a command…</span>
+          <Kbd>⌘K</Kbd>
