+/**
+ * v3 design embed: `ASv3.mount(el, { view, theme, accent, … })` renders one
+ * board with demo data. Built as one IIFE (vite.v3embed.config.ts) for the
+ * Claude Design canvas; `v3.html` uses the same entry for local renders.
+ */
+import type { CSSProperties, ReactNode } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import "../index.css";
+import { AcRoot } from "../ui/AcRoot.js";
+import { themeById } from "./themes/registry.js";
+import { resolveTheme, type Accent } from "./themes/resolve.js";
+import { VIEWS, type ViewId } from "./views.js";
+
+export interface MountOptions {
+  view?: ViewId;
+  theme?: string;
+  accent?: Accent;
+}
+
+export function Themed({ theme, accent = "theme", className, children }: { theme: string; accent?: Accent; className?: string; children: ReactNode }) {
+  const def = themeById(theme);
+  const { vars } = resolveTheme(def, accent);
+  return (
+    <AcRoot mode={def.mode} className={className} style={vars as CSSProperties}>
+      {children}
+    </AcRoot>
+  );
+}
+
+export function Board({ view = "main", theme = "darcula", accent = "theme" }: MountOptions) {
+  const render = VIEWS[view] ?? VIEWS.main;
+  return (
+    <Themed theme={theme} accent={accent} className="h-full">
+      {render({ theme, accent })}
+    </Themed>
+  );
+}
+
+const roots = new WeakMap<Element, Root>();
+
+export function mount(el: Element, o: MountOptions = {}): () => void {
+  const root = roots.get(el) ?? createRoot(el);
+  roots.set(el, root);
+  root.render(<Board {...o} />);
+  return () => {
+    root.unmount();
+    roots.delete(el);
+  };
+}
