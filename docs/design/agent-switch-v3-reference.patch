+    <aside className="flex w-[300px] shrink-0 flex-col overflow-hidden border-r border-ac-line bg-ac-panel">
+      <div className="flex h-9 shrink-0 items-center gap-2 border-b border-ac-line px-3">
+        <span className="text-[12px] font-semibold text-ac-text">Sessions</span>
+        <span className="ml-auto flex items-center">
+          <IconButton label="New session  ⌘N" className="size-7">
+            <Plus />
+          </IconButton>
+          <IconButton label="Select · group by project · density · show pinned" className="size-7">
+            <Ellipsis />
+          </IconButton>
+        </span>
+      </div>
+      {selecting && <BatchBar compact count={selection.length} className="mx-2 mt-2" />}
+      <div className="min-h-0 flex-1 overflow-y-auto pb-2">
+        <ZoneHead title="Needs you" count={NEEDS.length} aside={<span className="text-[10.5px] text-ac-muted">⌘J</span>} />
+        <div className="px-1.5">
+          {digest && (
+            <button type="button" className="flex h-7 w-full items-center gap-2 rounded-md px-2 text-left text-[12.5px] hover:bg-ac-raise">
+              <Inbox className="size-3.5 text-ac-muted" />
+              <span className="text-ac-text">While you were away</span>
+              <span className="text-ac-muted">· {digest.lines.length} updates</span>
+              <ChevronRight className="ml-auto size-3.5 text-ac-muted" />
+            </button>
+          )}
+          {NEEDS.slice(0, 3).map((n, i) => (
+            <NeedRow key={n.id} n={n} top={i === 0 && !focusNeed} focused={n.id === focusNeed} />
+          ))}
+          {NEEDS.length > 3 && (
+            <button type="button" className="h-6 px-2 text-[11px] text-ac-muted hover:text-ac-text">
+              {NEEDS.length - 3} more ›
