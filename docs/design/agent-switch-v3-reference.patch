+          <Label className="px-2">Sessions</Label>
+          <Row active icon={<StateDot state="idle" />} title="Rebind ADR discussion" meta="Library · kept · Oct 28" hint={<Kbd>↵ Resume…</Kbd>} />
+          <Row icon={<StateDot state="working" />} title="Fix wedge on daemon restart" meta="side · fix/wedge-restart" />
