+        )}
+        {TABS.map((id, i) => {
+          const t = sessionById(id);
+          const on = !pageTab && id === activeId;
+          return (
+            <div
+              key={id}
+              role="tab"
+              aria-selected={on}
+              title={`${t.title} · ⌘${i + 1}`}
+              className={cn(
+                TAB, "group min-w-[140px] max-w-[220px] shrink",
+                on ? TAB_ON : "border-transparent text-ac-muted hover:bg-ac-raise hover:text-ac-text",
