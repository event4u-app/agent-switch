+/* ------------------------------------------------------------- workbench */
+
+type TermLine = (typeof TERMINAL)[number];
+
+function TermText({ segs }: { segs: TermLine }) {
+  return (
+    <div className="whitespace-pre">
+      {segs.map(([text, ansi, bold], j) => (
+        <span key={j} style={{ color: ansi != null ? `var(--as-ansi-${ansi})` : undefined, fontWeight: bold ? 600 : undefined }}>
+          {text || " "}
+        </span>
+      ))}
+    </div>
+  );
+}
+
+/** The CLI's ╭─╮ boxes. xterm.js draws box glyphs itself (rounded arcs); the UI
+ *  font has none, so the mock draws the same box with a border — 6px, like every control. */
+function TermBox({ width, lines }: { width: number; lines: TermLine[] }) {
+  return (
+    <div className="my-[0.75em] rounded-md border px-[1ch] py-[0.7em]" style={{ width: `${width}ch`, borderColor: "var(--as-ansi-8)" }}>
+      {lines.map((l, i) => (
+        <TermText key={i} segs={l} />
+      ))}
+    </div>
+  );
+}
+
+export function TerminalView({ lines, className }: { lines: typeof TERMINAL; className?: string }) {
+  const out: ReactNode[] = [];
+  for (let i = 0; i < lines.length; i++) {
+    const first = lines[i][0]?.[0] ?? "";
+    if (first.startsWith("╭")) {
+      const width = first.length;
+      const inner: TermLine[] = [];
+      i++;
+      while (i < lines.length && !(lines[i][0]?.[0] ?? "").startsWith("╰")) {
+        const l = lines[i];
+        inner.push(l.slice(1, -1));
+        i++;
+      }
+      out.push(<TermBox key={i} width={width} lines={inner} />);
+      continue;
+    }
+    out.push(<TermText key={i} segs={lines[i]} />);
+  }
+  return (
+    <div
+      data-terminal
+      className={cn("min-h-0 overflow-hidden px-5 py-4 font-ac-mono text-[12.5px] leading-[1.5]", className)}
+      style={{ background: "var(--as-term-bg)", color: "var(--as-term-fg)" }}
+    >
+      {out}
+    </div>
+  );
+}
+
+/** Tab: rounded top corners; the active one is framed — a 2px accent top edge that
+ *  follows the rounded corners into the 1px side lines — and joins the content below. */
+const TAB = "relative -mb-px flex h-[33px] items-center gap-2 rounded-t-md border-x border-t-2 px-3 text-xs";
+const TAB_ON = "border-ac-line border-t-ac-brand bg-ac-bg text-ac-text";
+
+const TABS = ["s-store", "s-themes", "s-checkout", "s-hook"];
