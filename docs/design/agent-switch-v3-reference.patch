+          <TriangleAlert className="size-3.5" /> Engine stopped
+        </button>
+      )}
+      {showInbox && <button
+        type="button"
+        title="Needs you · ⌘J jumps to the next one"
+        className={cn(
+          "inline-flex h-7 items-center gap-1.5 whitespace-nowrap rounded-md border px-2.5 text-xs font-medium",
+          inboxOpen ? "border-ac-warn bg-ac-warn-tint text-ac-warn-text" : SESSIONS.some((x) => x.pr?.ci === "failing") ? "border-transparent bg-ac-alert-tint text-ac-alert-text" : "border-transparent bg-ac-warn-tint text-ac-warn-text",
+        )}
+      >
+        <Inbox className="size-3.5" /> {NEEDS.length}
+      </button>}
+      <Button variant="primary" size="sm" title="New session  ⌘N">
+        <Plus /> Start session
+      </Button>
+      <IconButton label="Settings  ⌘,">
+        <Settings />
+      </IconButton>
+    </header>
+  );
+}
+
+/* ------------------------------------------------------------- stripes */
+
+type StripeItem = { id: string; label: string; icon: ReactNode; dot?: boolean };
+
+export function Stripe({ side, items, active }: { side: "left" | "right"; items: StripeItem[]; active?: string | null }) {
+  return (
+    <nav
+      aria-label={side === "left" ? "Tool windows" : "Session panels"}
+      className={cn("flex w-11 shrink-0 flex-col items-center gap-1 bg-ac-rail py-2", side === "left" ? "border-r border-ac-line" : "border-l border-ac-line")}
+    >
+      {items.map((it) => {
+        const on = it.id === active;
+        return (
+          <button
+            key={it.id}
+            type="button"
+            title={it.label}
+            aria-pressed={on}
+            className={cn(
+              "relative inline-flex size-9 items-center justify-center rounded-md [&_svg]:size-[18px]",
+              on ? "bg-ac-raise text-ac-text" : "text-ac-muted hover:bg-ac-raise hover:text-ac-text",
+            )}
+          >
+            {on && <Marker />}
+            {it.icon}
+            {it.dot && <span className="absolute right-1 top-1 size-2 rounded-full bg-ac-warn" />}
+          </button>
+        );
+      })}
+    </nav>
+  );
+}
+
+/** Left stripe: Sessions is the tool window; the rest open as page tabs. */
+export const LEFT: StripeItem[] = [
+  { id: "sessions", label: "Sessions  ⌘B", icon: <ListTree />, dot: true },
+  { id: "library", label: "Library", icon: <Library /> },
+  { id: "accounts", label: "Accounts", icon: <Layers /> },
+  { id: "tools", label: "Tools", icon: <Wrench /> },
+];
+export const RIGHT: StripeItem[] = [
+  { id: "summary", label: "Summary  ⌘I", icon: <PanelLeft className="rotate-180" /> },
+  { id: "changes", label: "Changes", icon: <FileDiff /> },
+  { id: "children", label: "Children", icon: <GitBranch /> },
+];
+
+/* ------------------------------------------------------------- sessions window */
+
+export function childCount(s: V3Session): number {
+  return s.children.reduce((k, c) => k + (c.count ?? 1), 0);
+}
+export function childNoun(s: V3Session): string {
+  const n = childCount(s);
+  const kinds = new Set(s.children.map((c) => c.kind));
+  const noun = kinds.size === 1 && kinds.has("subagent") ? "subagent" : kinds.size === 1 && kinds.has("council-seat") ? "helper session" : "related session";
+  return `${n} ${n === 1 ? noun : noun + "s"}`;
+}
+
+/** The one trailing slot of a row, by priority: error > needs you > children. */
+function trailing(s: V3Session, needs: boolean): ReactNode {
+  const a = accountOf(s.account);
+  if (a.state === "near-limit") return <span className="shrink-0 text-[11px] text-ac-warn-text" title={`${a.name} is near its limit`}>{a.name}</span>;
+  if (s.pr?.ci === "failing") return <CircleX className="size-3.5 shrink-0 text-ac-alert" aria-label="CI failing" />;
+  if (s.pr?.mergeable === "conflict") return <TriangleAlert className="size-3.5 shrink-0 text-ac-alert" aria-label="conflict" />;
+  if (needs && s.state !== "needs-you") return <span className="size-1.5 shrink-0 rounded-full bg-ac-warn" aria-label="needs you" />;
+  const running = s.children.filter((c) => c.state === "working").length;
+  if (running) return <span className="inline-flex shrink-0 items-center gap-0.5 text-[11px] text-ac-muted" title={`${childNoun(s)} · ${running} running`}>
+    <Bot className="size-3.5" />{running}
+  </span>;
+  return null;
+}
+
+/** One line at rest; the selected row (or comfortable density) adds account · branch · PR. */
+export function SessionRow({ s, active, checked, open, selecting, comfortable, hover }: { s: V3Session; active?: boolean; checked?: boolean; open?: boolean; selecting?: boolean; comfortable?: boolean; hover?: boolean }) {
+  const a = accountOf(s.account);
+  const ref = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    if (active) ref.current?.scrollIntoView({ block: "nearest" });
+  }, [active]);
+  const needs = NEEDS.some((n) => n.session === s.id);
+  const second = active || comfortable;
+  return (
+    <div ref={ref}>
+      <div className={cn("relative rounded-md pl-2.5 pr-2", second ? "py-1.5" : "py-1", active ? "bg-ac-raise" : hover ? "bg-ac-raise" : "hover:bg-ac-raise")}>
+        {active && <Marker />}
+        <div className="flex h-5 min-w-0 items-center gap-2">
+          {selecting ? (
+            <span className={cn("inline-flex size-3.5 shrink-0 rounded border", checked ? "border-ac-brand bg-ac-brand" : "border-ac-line2")} />
+          ) : (
+            <StateDot state={s.state} />
+          )}
+          <span className={cn("min-w-0 flex-1 truncate text-[13px]", active ? "font-medium text-ac-text" : "text-ac-soft")} title={s.title}>
+            {s.name ?? s.title}
+          </span>
+          {trailing(s, needs)}
+        </div>
+        {second && (
+          <div className="mt-0.5 flex min-w-0 items-center gap-1.5 pl-4 text-[11px] text-ac-muted">
+            <span className="shrink-0">{a.name}</span>
+            <span>·</span>
+            <span className="truncate">{s.branch ?? "no repo"}</span>
+            {s.pr && <span className="shrink-0">· #{s.pr.number}</span>}
+          </div>
+        )}
+      </div>
+      {open && (
+        <div className="mb-1 ml-[18px] border-l border-ac-line pl-2">
+          {s.children.map((c) => (
+            <ChildLine key={c.id} c={c} />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+const VIA: Record<Child["source"], string> = {
+  hook: "via hook",
+  lineage: "via lineage",
+  git: "via git",
+  gh: "via GitHub",
+  heuristic: "relation unknown",
+  counted: "counted",
+  host: "via host",
+};
+
+/** Provenance only when it matters (unknown/counted); otherwise in the tooltip. */
+export function ChildLine({ c }: { c: Child }) {
+  const unknown = c.kind === "unknown";
+  const label = c.count ? `${c.count} ${c.label}` : c.label;
+  return (
+    <div className="flex h-6 min-w-0 items-center gap-2 text-[11.5px]" title={VIA[c.source] + (c.detail ? ` · ${c.detail}` : "")}>
+      <StateDot state={c.state} />
+      <span className="min-w-0 flex-1 truncate text-ac-soft">{label}</span>
+      {(unknown || c.source === "counted") && <span className={cn("shrink-0 text-[10.5px]", unknown ? "text-ac-warn-text" : "text-ac-muted")}>{unknown ? "relation unknown ⓘ" : "counted"}</span>}
+    </div>
+  );
+}
+
+function ZoneHead({ title, count, aside }: { title: string; count?: number; aside?: ReactNode }) {
+  return (
+    <div className="sticky top-0 z-[1] flex h-8 items-center gap-2 bg-ac-panel px-3.5">
+      <span className="text-[11px] font-semibold text-ac-soft">{title}</span>
+      {count != null && <span className="text-[11px] text-ac-muted">{count}</span>}
+      <span className="ml-auto flex items-center gap-1">{aside}</span>
+    </div>
+  );
+}
+
+/** One order everywhere (window, tray): needs you · error · working · rest. */
+export function liveSorted(): V3Session[] {
+  const rank = (x: V3Session) => (NEEDS.some((n) => n.session === x.id) ? 0 : x.pr?.ci === "failing" ? 1 : x.state === "working" ? 2 : 3);
+  return SESSIONS.filter((s) => s.state !== "done").sort((a, b) => rank(a) - rank(b));
+}
+
+export interface Digest {
+  title: string;
+  lines: { icon: ReactNode; text: string; verb?: string }[];
+}
+
+export function SessionsWindow({
+  activeId = "s-store",
+  selection,
+  openId,
+  focusNeed,
+  digest,
+  comfortable,
+  hoverId,
+  limitsOpen,
+}: {
+  activeId?: string;
+  selection?: string[];
+  openId?: string;
+  focusNeed?: string;
+  digest?: Digest;
+  comfortable?: boolean;
+  hoverId?: string;
+  limitsOpen?: boolean;
