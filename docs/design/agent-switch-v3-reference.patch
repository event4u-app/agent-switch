+
+/** A banner across the workbench for system problems (engine, tmux). */
+export function SystemBanner({ children, action }: { children: ReactNode; action: ReactNode }) {
+  return (
+    <div className="flex shrink-0 items-center gap-3 border-b border-ac-alert bg-ac-alert-tint px-4 py-2 text-xs text-ac-alert-text">
