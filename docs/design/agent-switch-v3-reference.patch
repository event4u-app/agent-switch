@@ -0,0 +1,209 @@
+/**
+ * Account limits — one look everywhere (dock, Summary, start dialog, tray,
+ * accounts page). Bars carry a pace tick; stale data is greyed with its age.
+ */
+import { cn } from "../lib/utils.js";
+import { Clock } from "lucide-react";
+import { AccountMark, Chip } from "./kit.js";
+import type { Limit, V3Account } from "./data.js";
+
+export function tone(used: number | null, protect: number): "ok" | "warn" | "alert" | "none" {
+  if (used == null) return "none";
+  if (used >= protect) return "alert";
+  if (used >= protect - 15) return "warn";
+  return "ok";
+}
+
+const FILL = { ok: "bg-ac-ok", warn: "bg-ac-warn", alert: "bg-ac-alert", none: "bg-ac-faint" } as const;
+const TEXT = { ok: "text-ac-soft", warn: "text-ac-warn-text", alert: "text-ac-alert-text", none: "text-ac-muted" } as const;
+
+/** One window: label · bar · used % · reset. Full-size bars add the pace tick
+ *  (expected use by now); the warn threshold is shown by the bar colour, not a line. */
+export function LimitBar({ l, protect, stale, compact }: { l: Limit; protect: number; stale?: boolean; compact?: boolean }) {
+  const t = stale ? "none" : tone(l.used, protect);
+  return (
+    <div className={cn("grid items-center gap-2", compact ? "grid-cols-[64px_1fr_32px]" : "grid-cols-[76px_1fr_36px_64px]")}>
+      <span className="truncate text-[11px] text-ac-muted">{l.label.replace("week · ", "week ")}</span>
+      <span className="relative block h-1.5 rounded-full bg-ac-raise" title={l.pace != null ? `pace: ${l.pace}% expected by now` : undefined}>
+        <span className={cn("absolute inset-y-0 left-0 rounded-full", FILL[t], stale && "opacity-50")} style={{ width: `${l.used ?? 0}%` }} />
+        {!compact && l.pace != null && <span className="absolute -top-1 h-3.5 w-0.5 -translate-x-1/2 rounded-full bg-ac-text" style={{ left: `${l.pace}%` }} />}
+      </span>
+      <span className={cn("text-right font-ac-mono text-[11px]", TEXT[t])}>{l.used == null ? "—" : `${l.used}%`}</span>
+      {!compact && <span className="truncate text-right font-ac-mono text-[11px] text-ac-muted">↻ {l.resetsIn}</span>}
+    </div>
+  );
+}
+
+/** The two windows nearest to running out, then "+N". */
+export function nearest(a: V3Account, n = 2): Limit[] {
+  return [...a.limits].sort((x, y) => (y.used ?? -1) - (x.used ?? -1)).slice(0, n);
+}
+
+export function StateWord({ a }: { a: V3Account }) {
+  if (a.state === "near-limit") return <Chip kind="status" tone="warn">Near limit</Chip>;
+  if (a.state === "sign-in") return <Chip kind="meta">Sign-in needed</Chip>;
+  if (a.state === "unknown") return <Chip kind="meta">usage unknown</Chip>;
+  return null;
+}
+
+/** Dock row: name, exception word, 2 bars; the same component in tray and Summary. */
+export function AccountLimits({ a, wide, bare }: { a: V3Account; wide?: boolean; bare?: boolean }) {
+  const shown = wide ? a.limits : nearest(a);
+  const more = a.limits.length - shown.length;
+  return (
+    <div className="rounded-md px-2 py-1.5 hover:bg-ac-raise" title={a.limits.map((l) => `${l.label} ${l.used}% · resets ${l.resetsIn}`).join("\n") + `\nchecked ${a.checked}`}>
+      <div className={cn("flex min-w-0 items-center gap-2", bare && "hidden")}>
+        <AccountMark color={a.color} />
+        <span className="truncate text-xs font-medium text-ac-text">{a.name}</span>
+        {a.next && <span className="shrink-0 text-[10.5px] text-ac-info-text">→ next</span>}
+        <StateWord a={a} />
+        <span className="ml-auto shrink-0 font-ac-mono text-[10.5px] text-ac-muted">
+          {a.stale ? `${a.checked} · refreshing` : a.checked === "—" ? "" : a.checked}
+        </span>
+      </div>
+      {shown.length > 0 ? (
+        <div className={cn("space-y-1", bare ? "" : "mt-1.5 pl-4")}>
+          {shown.map((l) => (
+            <LimitBar key={l.label} l={l} protect={a.protect} stale={a.stale} compact={!wide} />
+          ))}
+          {more > 0 && <div className="text-[10.5px] text-ac-faint">+{more} more window</div>}
+        </div>
+      ) : (
+        <div className="mt-1 pl-4 text-[11px] text-ac-muted">No usage before the first sign-in</div>
+      )}
+    </div>
+  );
+}
+
+/** Tightest window whose label starts with `prefix` (week → "week · Opus" if that is fuller). */
+export function tightest(a: V3Account, prefix: string): Limit | undefined {
+  return a.limits.filter((l) => l.label.startsWith(prefix)).sort((x, y) => (y.used ?? -1) - (x.used ?? -1))[0];
+}
+
+function Mini({ l, protect, stale }: { l?: Limit; protect: number; stale?: boolean }) {
+  if (!l) return <span className="w-[74px]" />;
+  const t = stale ? "none" : tone(l.used, protect);
+  return (
+    <span className="grid w-[74px] grid-cols-[1fr_28px] items-center gap-1.5" title={`${l.label}: ${l.used}% · resets in ${l.resetsIn}`}>
+      <span className="relative block h-1.5 rounded-full bg-ac-raise">
+        <span className={cn("absolute inset-y-0 left-0 rounded-full", FILL[t], stale && "opacity-50")} style={{ width: `${l.used ?? 0}%` }} />
+      </span>
+      <span className={cn("text-right font-ac-mono text-[10.5px]", TEXT[t])}>{l.used}%</span>
+    </span>
+  );
+}
+
+/** One line per account for the dock: name · 5 h · week (tightest weekly window). */
+export function AccountLine({ a }: { a: V3Account }) {
+  const all = a.limits.map((l) => `${l.label} ${l.used}% · resets ${l.resetsIn}`).join("\n");
+  return (
+    <div className="flex h-7 items-center gap-2 rounded-md px-1.5 hover:bg-ac-raise" title={`${a.tool} · ${a.name}\n${all}\nchecked ${a.checked}`}>
+      <AccountMark color={a.color} />
+      <span className="min-w-0 flex-1 truncate text-xs text-ac-text">
+        {a.name}
+        {a.next && <span className="ml-1.5 text-[10.5px] text-ac-info-text">→ next</span>}
+        {a.stale && (
+          <span className="ml-1.5 inline-flex items-center gap-0.5 text-[10.5px] text-ac-muted" title={`usage checked ${a.checked} — refreshing`}>
+            <Clock className="size-3" />
+            {a.checked.replace(" ago", "")}
+          </span>
+        )}
+      </span>
+      {a.state === "sign-in" ? (
+        <button type="button" className="h-5 shrink-0 rounded px-1.5 text-[11px] font-medium text-ac-brand-text hover:bg-ac-brand-tint">
+          Sign in
+        </button>
+      ) : (
+        <>
+          <Mini l={tightest(a, "5h")} protect={a.protect} stale={a.stale} />
+          <Mini l={tightest(a, "week")} protect={a.protect} stale={a.stale} />
+        </>
+      )}
+    </div>
+  );
+}
+
+/** Limits strip row: provider · name · one bar (tightest window) · numbers only when not OK. */
+export function LimitRow({ a, hover, first }: { a: V3Account; hover?: boolean; first?: boolean }) {
+  const top = nearest(a, 1)[0];
+  const t = a.stale ? "none" : tone(top?.used ?? null, a.protect);
+  return (
+    <div className={cn("flex h-6 items-center gap-2 rounded-md px-2", hover ? "bg-ac-raise" : "hover:bg-ac-raise")} title={a.limits.map((l) => `${l.label} ${l.used}% · resets in ${l.resetsIn}`).join("\n")}>
+      <span className="min-w-0 flex-1 truncate text-xs text-ac-soft">
+        {a.name}
+        {a.tool === "codex" && <span className="text-ac-muted"> · Codex</span>}
+        {a.next && <span className="ml-1 text-ac-muted" title="Next for new sessions">→</span>}
+        {a.stale && (
+          <span className="ml-1 text-[11px] text-ac-muted" title={`Usage data is ${a.checked.replace(" ago", "")} old — refreshing`}>
+            · {a.checked.replace(" ago", "")} old
+          </span>
+        )}
+      </span>
+      {a.state === "sign-in" ? (
+        <button type="button" className="shrink-0 text-[11px] text-ac-muted hover:text-ac-text">
+          sign in ›
+        </button>
+      ) : (
+        <>
+          {t !== "ok" && t !== "none" && top && (
+            <span className={cn("shrink-0 font-ac-mono text-[10.5px]", TEXT[t])}>
+              {top.used}% · {top.resetsIn}
+            </span>
+          )}
+          <span className="relative block h-1 w-16 shrink-0 rounded-full bg-ac-raise">
+            <span className={cn("absolute inset-y-0 left-0 rounded-full", FILL[t], a.stale && "opacity-50")} style={{ width: `${top?.used ?? 0}%` }} />
+          </span>
+        </>
+      )}
+    </div>
+  );
+}
+
+/** Says in words what the tick shows: which window runs ahead of an even pace. */
+export function PaceLine({ a }: { a: V3Account }) {
+  const ahead = a.limits.filter((l) => l.used != null && l.pace != null && l.used - l.pace >= 10);
+  return (
+    <p className="mt-2 text-[11px] leading-relaxed text-ac-muted">
+      {ahead.length ? (
+        ahead.map((l) => (
+          <span key={l.label} className="block">
+            <span className="text-ac-warn-text">{l.label} runs ahead</span> · {l.used}% used, {l.pace}% expected by now
+          </span>
+        ))
+      ) : (
+        <span className="block">Every window is on pace</span>
+      )}
+      <span className="block">Tick = even pace · amber from {a.protect - 15}%, red from {a.protect}%</span>
+    </p>
+  );
+}
+
+/** Popover from a limits row: every window, pace in words, actions. Never switches on its own. */
+export function LimitsPopover({ a }: { a: V3Account }) {
+  return (
+    <div className="w-[320px] rounded-xl border border-ac-line2 bg-ac-panel p-3" style={{ boxShadow: "var(--ac-shadow)" }}>
+      <div className="mb-2 flex items-center gap-2">
+        <AccountMark color={a.color} />
+        <span className="text-[13px] font-medium text-ac-text">
+          {a.tool === "claude" ? "Claude" : "Codex"} · {a.name}
+        </span>
+        <StateWord a={a} />
+        <span className="ml-auto text-[11px] text-ac-muted">checked {a.checked}</span>
+      </div>
+      <div className="space-y-1.5">
+        {a.limits.map((l) => (
+          <LimitBar key={l.label} l={l} protect={a.protect} />
+        ))}
+      </div>
+      <PaceLine a={a} />
+      <div className="mt-2.5 flex gap-1.5">
+        <button type="button" className="h-7 rounded-md border border-ac-line2 px-2.5 text-xs text-ac-soft hover:text-ac-text">
+          Move its session…
+        </button>
+        <button type="button" className="h-7 rounded-md px-2.5 text-xs text-ac-muted hover:text-ac-text">
+          Open Accounts
+        </button>
+      </div>
+    </div>
+  );
+}
