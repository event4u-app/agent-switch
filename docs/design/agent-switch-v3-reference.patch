+          <button type="button" className="mt-0.5 flex h-7 w-full items-center gap-2 rounded-md px-2.5 text-[11.5px] text-ac-muted hover:bg-ac-raise hover:text-ac-text" title="Finished sessions; merged ones archive themselves">
+            <ChevronRight className="size-3" /> Done today {done.length}
+            <span className="ml-auto">Clean up</span>
+          </button>
+        </div>
+      </div>
+      <LimitsStrip open={limitsOpen} />
+    </aside>
+  );
+}
+
+/** Bottom strip: one bar per account (tightest window); numbers only when it matters. */
+export function LimitsStrip({ open }: { open?: boolean }) {
+  return (
+    <section className="relative shrink-0 border-t border-ac-line px-1.5 pb-1.5 pt-1">
+      <div className="flex h-7 items-center px-2">
+        <span className="text-[11px] font-semibold text-ac-soft">Limits</span>
+      </div>
