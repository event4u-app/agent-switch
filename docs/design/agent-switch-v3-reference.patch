+              ["Antigravity", "not installed", false],
+            ].map(([n, d, ok]) => (
+              <div key={n as string} className="flex items-center gap-3 border-b border-ac-line px-4 py-3 last:border-b-0">
+                {ok ? <CircleCheck className="size-4 text-ac-ok" /> : <Download className="size-4 text-ac-muted" />}
+                <span className="min-w-0 flex-1">
+                  <span className="block text-[13px] text-ac-text">{n}</span>
+                  <span className="block font-ac-mono text-[11px] text-ac-muted">{d}</span>
+                </span>
