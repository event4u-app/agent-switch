+/**
+ * v3 design data (proposal). Shapes follow road-to-agent-switch-v3-central
+ * (Phases 2–4): every relation and git/PR fact carries the source it came from;
+ * a relation AS cannot prove is `kind: "unknown"`. Demo values only.
+ */
+import type { IdentityColor, SessionState, Tool } from "../vm/types.js";
+
+/** Where a fact came from (roadmap constraint "every edge says where it came from"). */
+export type Source = "hook" | "lineage" | "git" | "gh" | "heuristic" | "counted" | "host";
+export type Kind = "subagent" | "helper" | "council-seat" | "continued" | "unknown";
+
+export interface PR {
+  number: number;
+  title: string;
+  lifecycle: "open" | "draft" | "merged" | "closed";
+  ci: "passing" | "failing" | "running" | "unknown";
+  mergeable: "clean" | "conflict" | "blocked" | "unknown";
+  review: "approved" | "changes" | "required" | "none" | "unknown";
+  checks?: { name: string; state: "passing" | "failing" | "running" }[];
+}
+
+export interface Child {
+  id: string;
+  label: string;
+  kind: Kind;
+  state: SessionState;
+  source: Source;
+  agent?: string;
+  branch?: string;
+  worktree?: string;
+  detail?: string;
+  /** Children known only by count (no hooks): one row stands for `count` sessions. */
+  count?: number;
+}
+
+export interface Limit {
+  /** "5h", "week", "week · Opus" … as the provider reports it. */
+  label: string;
+  used: number | null;
+  resetsIn: string | null;
+  /** Expected use at this point of the window (pace tick), 0–100. */
+  pace?: number;
+}
+
+export interface V3Account {
+  id: string;
+  name: string;
+  tool: Tool;
+  color: IdentityColor;
+  email: string;
+  label: "Work" | "Personal" | "Other";
+  state: "ready" | "near-limit" | "sign-in" | "unknown";
+  isDefault?: boolean;
+  next?: boolean;
+  protect: number;
+  limits: Limit[];
+  checked: string;
+  stale?: boolean;
+  live: number;
+}
+
+export interface V3Session {
+  id: string;
+  title: string;
+  tool: Tool;
+  account: string;
+  state: SessionState;
+  /** AS hosts it (tmux): survives app restart, can be typed into. */
+  hosted: boolean;
+  /** Where its terminal is: a dock tab, detached (still running), or the user's own terminal. */
+  terminal: "dock" | "detached" | "own";
+  project: string;
+  path: string;
+  branch: string | null;
+  branchSource: Source;
+  worktree: string | null;
+  dirty: number;
+  ahead: number;
+  behind: number;
+  pr: PR | null;
+  children: Child[];
+  /** Helper sessions start collapsed (decision C2). */
+  collapsed?: boolean;
+  pinned?: boolean;
+  name?: string;
+  model: string;
+  /** Thinking / reasoning effort, in the tool's own words. */
+  effort: string;
+  context: number;
+  lastActive: string;
+  started: string;
+  needs?: string;
+  /** AS host window (tmux), per account. */
+  host?: string;
+  /** Last line of the pane (capture-pane), for the quick-input preview. */
+  preview?: string;
+  continuedFrom?: { title: string; account: string; how: "takeover" | "handoff" | "fork" | "compact" };
+}
+
+export const ACCOUNTS: V3Account[] = [
+  {
+    id: "claude:work", name: "work", tool: "claude", color: "teal", email: "work@example.com", label: "Work", state: "ready", isDefault: true, next: true, protect: 95,
+    limits: [
