+        open ? "bg-ac-raise text-ac-text shadow-[inset_0_0_0_1px_var(--ac-line2)]" : "text-ac-soft hover:bg-ac-raise hover:text-ac-text",
+        locked && "cursor-not-allowed opacity-60 hover:bg-transparent",
+      )}
+    >
+      {children}
+      {locked ? <Lock className="size-3 text-ac-muted" /> : <ChevronDown className="size-3 text-ac-muted" />}
+    </button>
+  );
+}
+
+export function SessionBar({ s, view = "terminal", menuOpen, chipOpen }: { s: V3Session; view?: "terminal" | "chat"; menuOpen?: boolean; chipOpen?: "model" | "effort" }) {
