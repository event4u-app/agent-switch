+            <div className="flex shrink-0 items-center gap-3 border-b border-ac-line bg-ac-panel px-4 py-2">
+              <CircleX className="size-4 shrink-0 text-ac-alert" />
+              <span className="min-w-0 flex-1 text-xs leading-snug text-ac-soft">
+                {NEXT[s.id].text}
+              </span>
+              <Act kind="accent">{NEXT[s.id].action}</Act>
+              <IconButton label="Dismiss" className="size-6">
+                <X />
+              </IconButton>
+            </div>
+          )}
+          {body ?? (s.terminal === "own" ? <ExternalBody s={s} /> : <TerminalView className="flex-1" lines={activeId === "s-checkout" ? TERMINAL_CHECKOUT : TERMINAL} />)}
+        </>
+      )}
+    </section>
+  );
+}
+
+/** A session in the user's own terminal: read-only mirror plus the way there. */
+export function ExternalBody({ s }: { s: V3Session }) {
+  return (
+    <div className="flex min-h-0 flex-1 flex-col">
+      <div className="flex shrink-0 items-center gap-3 border-b border-ac-line bg-ac-panel px-4 py-2">
+        <SquareTerminal className="size-4 shrink-0 text-ac-muted" />
+        <span className="min-w-0 flex-1 text-xs text-ac-soft">
+          Runs in <span className="text-ac-text">Terminal.app · tab 3</span> · read-only here
+        </span>
+        <Act kind="accent" kbd="⌘↵">
+          Focus terminal
+        </Act>
