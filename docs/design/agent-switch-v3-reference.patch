+            >
+              <StateDot state={t.state} />
+              <span className="truncate">{t.title}</span>
+              <span className="ml-auto shrink-0 font-ac-mono text-[10px] text-ac-muted">⌘{i + 1}</span>
+            </div>
+          );
+        })}
+      </div>
+      {pageTab ? (
+        body
+      ) : (
+        <>
+          <SessionBar s={s} view={view} menuOpen={menuOpen} chipOpen={chipOpen} />
