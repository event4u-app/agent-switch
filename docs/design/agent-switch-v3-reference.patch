+ * title bar · left stripe + Sessions tool window · workbench · right stripe + tool window.
+ * Dots mean state only; account identity is a tick (AccountMark). One filled
+ * button per surface: Start session in the chrome.
+ */
+import { useEffect, useRef, type ReactNode } from "react";
+import {
+  Bot,
+  Brain,
+  ChevronDown,
+  ChevronRight,
+  CircleCheck,
+  CircleX,
+  Download,
+  Ellipsis,
+  FileDiff,
+  FolderGit2,
+  GitBranch,
+  GitPullRequest,
+  Hand,
+  Inbox,
+  Layers,
+  Library,
+  ListTree,
